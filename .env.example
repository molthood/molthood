# Console configuration. Copy to `.env.local` for local development.
#
# Only one variable, and it is `NEXT_PUBLIC_` — meaning it is INLINED INTO THE
# BUNDLE AT BUILD TIME, not read when the page runs. Two consequences:
#
#   1. Changing it on Vercel does nothing until you redeploy.
#   2. Never put a secret here. Every visitor can read it.
#
# The console holds no credentials of its own. The API key that pays for an
# analysis is typed by the person using it and stays in their browser, which is
# why this file has nothing sensitive to protect.

# Where the FastAPI backend lives. No trailing slash.
# Local:      http://127.0.0.1:8000
# Production: https://api.molthood.org  (or the railway.app host it hands you)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# ── Molt AI ────────────────────────────────────────────────────────────────
# The assistant at /ai. Server-side only: a NEXT_PUBLIC_ prefix would inline
# the key into the browser bundle, which for a billed inference key means
# handing out the ability to spend.
AI_BASE_URL=https://gorouter.app/v1
AI_API_KEY=
AI_MODEL=claude-opus-5-thinking

# Optional. Comma-separated model ids this deployment is willing to offer. When
# unset the picker shows everything the provider lists; when set it narrows
# that list, and is the whole list if the provider cannot be reached.
AI_MODELS=

# Lets Molt AI run real Molthood analyses. Optional: without it the analysis
# tool reports that it could not run, which the model is instructed to say.
MOLTHOOD_API_KEY=

# Additional AI providers. A model routes to the first of its providers that is
# answering, so these are what make Gemini, DeepSeek and GPT reachable. All
# server-side: a NEXT_PUBLIC_ prefix would inline a spending key into the
# browser bundle.
GOOGLE_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GOOGLE_AI_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=
VIRTUALS_BASE_URL=https://compute.virtuals.io/v1
VIRTUALS_API_KEY=

# The developer platform, closed to the public while it is built. Every page
# and component still exists and still compiles; this only decides whether a
# request is served the platform or the status page. Set to `true` to reopen.
DASHBOARD_ENABLED=false
