# --- Application ---
APP_NAME="Molthood API"
APP_ENV=local
APP_VERSION=0.4.0
API_PREFIX=/api/v1
DEBUG=false

# --- Networking ---
HOST=127.0.0.1
PORT=8000
# Comma-separated list.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Logging ---
LOG_LEVEL=INFO
# "console" for human-readable local output, "json" for shipping.
LOG_FORMAT=console

# --- Robinhood Chain (public mainnet — no API key required) ---
CHAIN_ID=4663
CHAIN_NAME="Robinhood Chain"
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
BLOCKSCOUT_BASE_URL=https://robinhoodchain.blockscout.com

# --- AI summarizer (required for the summary stage) ---
# Without this key, executions still return real on-chain evidence; the
# summary stage reports `service_not_configured` instead of inventing text.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Good options for this workload, cheapest first:
#   anthropic/claude-haiku-4.5   $1 / $5   per 1M tokens
#   anthropic/claude-sonnet-5    $2 / $10  (intro pricing until 2026-08-31)
#   anthropic/claude-opus-5      $5 / $25
OPENROUTER_MODEL=anthropic/claude-sonnet-5
OPENROUTER_API_KEY=

# --- Market data (optional; Codex may not index chain 4663) ---
CODEX_BASE_URL=https://graph.codex.io
CODEX_API_KEY=

# --- Outbound resilience ---
HTTP_MAX_ATTEMPTS=3
HTTP_CONNECT_TIMEOUT=5.0
HTTP_READ_TIMEOUT=15.0

# --- Engine limits ---
MAX_CONCURRENT_EXECUTIONS=8
EXECUTION_TIMEOUT_SECONDS=60

# --- Persistence ---
# SQLite by default so history survives a restart on a machine with nothing
# installed. Point this at PostgreSQL and no code changes.
DATABASE_URL=sqlite:///./molthood.db
# DATABASE_URL=postgresql+psycopg://molthood:molthood@localhost:5432/molthood
REDIS_URL=redis://localhost:6379/0

# How long a stored analysis is served instead of being re-run.
ANALYSIS_CACHE_SECONDS=600
# Token positions screened per wallet analysis. Each costs four explorer reads.
PORTFOLIO_MAX_HOLDINGS=8
# How far back change detection looks for the previous run of a subject.
CHANGE_LOOKBACK_DAYS=30

# --- Authentication ---
# Analyses spend real inference credit — roughly a cent each — so they require
# a key and are metered. Setting this to false opens them to anyone who can
# reach the port; only sensible for local development.
AUTH_REQUIRED=true
DEFAULT_DAILY_QUOTA=50
ADMIN_DAILY_QUOTA=1000
# Keys one address may mint per day. Without a cap, self-serve signup is just
# a slower route to unlimited quota.
SIGNUP_KEYS_PER_IP_PER_DAY=3

# --- Rate limiting ---
# Caps pace, not spend. Per-process and lost on restart, which is fine: the
# quota above is the one that guards money and lives in the database.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
# Only enable behind a proxy that overwrites `x-forwarded-for`. The header is
# caller-supplied, so trusting it on a directly-exposed service lets anyone
# reset their own rate limit by inventing one.
TRUST_PROXY_HEADERS=false

# --- Background monitoring ---
# Off by default: a monitor that started itself would begin spending every
# existing key's quota the moment a new version deployed.
MONITOR_ENABLED=false
MONITOR_TICK_SECONDS=60
MONITOR_BATCH_SIZE=5
# Floor on how often one watch may run — each check costs the owner a unit.
WATCH_MIN_INTERVAL_SECONDS=900
WATCH_DEFAULT_INTERVAL_SECONDS=3600

# --- Four-byte selector registry (no key, no account) ---
# Recovers what an unverified contract can do from its deployed bytecode, so
# the power scan is not blank for the ~12% of tokens with no published source.
OPENCHAIN_BASE_URL=https://api.openchain.xyz

# --- GoPlus token security (optional; anonymous works, throttled ~10 req) ---
# Both halves are needed to sign. Note the shapes are the reverse of the usual
# convention: the key is 20 characters, the secret is 32.
GOPLUS_APP_KEY=
GOPLUS_APP_SECRET=

# =============================================================================
# Capability providers
# =============================================================================
# Every one is optional. A missing key makes that provider unavailable and
# nothing else: the application starts, `/api/health` names the variable that
# would enable it, and the router routes around it.
#
# Adding a key and restarting is the only step. No code changes, ever.
#
# With none of these set, the platform still runs website audits and repository
# analysis — Jina Reader needs no credential. Check `/api/v1/providers` to see
# exactly what this deployment can currently do.

# Master switch. Set false to disable the whole layer without unsetting eight
# variables — useful when isolating a problem.
PROVIDERS_ENABLED=true

# --- Exa: search by meaning, similar pages, page contents --------------------
# Unlocks: web_search, semantic_search, similar_pages, read_url
# Results carry page text, so a search and a read are one call.
EXA_BASE_URL=https://api.exa.ai
EXA_API_KEY=

# --- Tavily: answer-shaped search and news -----------------------------------
# Unlocks: web_search, news_search, read_url
# The only news-ordered source in the layer.
TAVILY_BASE_URL=https://api.tavily.com
TAVILY_API_KEY=

# --- Jina Reader: URL to clean markdown --------------------------------------
# Unlocks: read_url
# Works WITHOUT a key — anonymous use is rate-limited, not refused. A key only
# raises the limit. This is what keeps a keyless deployment able to read pages.
JINA_READER_URL=https://r.jina.ai
JINA_API_KEY=

# --- Firecrawl: browser-rendered scraping ------------------------------------
# Unlocks: read_url, crawl_site, extract_structured, screenshot, web_search
# Reaches content a plain fetch cannot, and bills accordingly — which is why
# the router prefers Jina for a plain read.
FIRECRAWL_BASE_URL=https://api.firecrawl.dev
FIRECRAWL_API_KEY=

# --- E2B: sandboxed code execution -------------------------------------------
# Unlocks: run_code
# ALSO needs the `e2b-code-interpreter` package installed. With a key and no
# package the provider reports that specifically rather than failing on use.
E2B_API_KEY=
# Optional custom sandbox image. Empty uses E2B's default.
E2B_TEMPLATE=

# --- Upstash Redis: shared cache ---------------------------------------------
# Unlocks: cache
# BOTH halves are required. Without them the cache falls back to memory, which
# is correct but per-process — four workers means four caches. `/api/health`
# reports which backend is actually answering.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Upstash QStash: deferred and scheduled work ------------------------------
# Unlocks: queue
# QStash delivers by calling a PUBLIC URL back, so the callback base is as
# necessary as the token — a laptop cannot receive deliveries however valid its
# credentials are. Set this to the deployment's public origin.
QSTASH_BASE_URL=https://qstash.upstash.io
QSTASH_TOKEN=
QSTASH_CALLBACK_BASE_URL=

# --- PostHog: product analytics ----------------------------------------------
# Unlocks: analytics
# Never affects a request: events are queued, flushed in the background, and
# every failure is swallowed. Use https://eu.i.posthog.com for the EU region.
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_API_KEY=
ANALYTICS_ENABLED=true

# --- QStash: receiving deliveries --------------------------------------------
# Publishing and receiving use DIFFERENT credentials. The token above
# authorises us to QStash; these prove an incoming delivery came from QStash.
#
# Without them the callback endpoint refuses everything — an unverified public
# endpoint that executes work is worse than having no queue at all.
#
# Two keys so a rotation does not drop messages already in flight. Both are in
# console.upstash.com → QStash → Details.
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# --- Web intelligence: public endpoints, no account needed --------------------
# These answer questions about a *site* rather than a chain: who registered the
# domain, when it first appeared, what certificates exist for it. Every one has
# a working public default, so this whole block can stay untouched — it is here
# so a deployment can repoint one without a code change.
MICROLINK_BASE_URL=https://api.microlink.io
DOH_BASE_URL=https://cloudflare-dns.com/dns-query
RDAP_BOOTSTRAP_URL=https://data.iana.org/rdap/dns.json
CRTSH_BASE_URL=https://crt.sh
WAYBACK_AVAILABILITY_URL=https://archive.org/wayback/available
WAYBACK_CDX_URL=https://web.archive.org/cdx/search/cdx
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_RAW_BASE_URL=https://raw.githubusercontent.com

# crt.sh routinely takes 30s+. It needs a budget of its own or it would eat the
# entire execution timeout on its own.
CRTSH_TIMEOUT_SECONDS=45

# OpenGraph answers the same question Microlink does, so it is a corroborating
# second opinion rather than a dependency — an analysis is complete without it.
OPENGRAPH_BASE_URL=https://opengraph.io/api/1.1
OPENGRAPH_API_KEY=

# Raises the GitHub rate limit from 60 requests an hour to 5,000. Unauthenticated
# works and is throttled; a read-only token with no scopes is enough.
GITHUB_TOKEN=

# --- Fetching arbitrary third-party sites ------------------------------------
# Sent on every outbound request so a site operator can identify and contact us.
# Point the URL at the real deployment once the domain is live.
WEB_USER_AGENT=Molthood/0.6 (+https://molthood.org)
WEB_FETCH_TIMEOUT_SECONDS=15
# Hard ceiling on a downloaded body. An arbitrary URL may point at a multi-
# gigabyte file, and it must not be streamed into memory.
WEB_FETCH_MAX_BYTES=5000000
